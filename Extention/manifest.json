{
  "manifest_version": 3,
  "name": "Yandex Review Response Assistant",
  "version": "0.4.0",
  "description": "Помогает генерировать ответы на отзывы в Яндекс Бизнесе",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:5005/*"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "Review Assistant"
  },
  "content_scripts": [
    {
      "matches": ["https://yandex.ru/sprav/*/p/edit/reviews/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}